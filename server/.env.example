# 火山引擎 - 豆包语音识别大模型（控制台开通「大模型流式语音识别」后获取）
VOLC_APP_KEY=
VOLC_ACCESS_KEY=
# 小时版 volc.seedasr.sauc.duration / 并发版 volc.seedasr.sauc.concurrent
VOLC_RESOURCE_ID=volc.seedasr.sauc.duration

# 火山方舟 Ark - 豆包大模型（翻译用），ARK_MODEL 填推理接入点 ID 如 ep-xxxx 或模型名
ARK_API_KEY=
ARK_MODEL=

# 中继服务器自身
PORT=8080
# 小程序 ?token= 与之匹配，留空则不校验（仅调试用）
AUTH_TOKEN=
