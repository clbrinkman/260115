# 火山引擎 - 豆包语音同传大模型 AST v2（控制台开通「同声传译2.0」后获取）
# 新版控制台：只填 VOLC_API_KEY 即可（推荐）
VOLC_API_KEY=
# 旧版控制台：填下面两个（VOLC_API_KEY 存在时忽略这两个）
VOLC_APP_KEY=
VOLC_ACCESS_KEY=

# 翻译语种（AST v2 支持 20 外语 + 粤语/上海话，源或目标必须含 zh/en）
SOURCE_LANG=zh
TARGET_LANG=en

# 会议纪要 LLM（OpenAI 兼容接口，默认 DeepSeek；也可改指火山方舟等任何兼容服务）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 中继服务器自身
PORT=8080
# 小程序 ?token= 与之匹配，留空则不校验（仅调试用）
AUTH_TOKEN=
