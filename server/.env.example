# 火山引擎 - 豆包语音同传大模型 AST v2（控制台开通「同声传译2.0」后获取）
# 新版控制台：只填 VOLC_API_KEY 即可（推荐）
VOLC_API_KEY=
# 旧版控制台：填下面两个（VOLC_API_KEY 存在时忽略这两个）
VOLC_APP_KEY=
VOLC_ACCESS_KEY=

# 翻译语种（AST v2 支持 20 外语 + 粤语/上海话，源或目标必须含 zh/en）
SOURCE_LANG=zh
TARGET_LANG=en

# 链路选择：ast=火山同传（默认，功能全） mt=美团内部ASR+LLM（保底，无说话人分离）
ASR_PROVIDER=ast

# ---- 保底链路：美团内部智能语音平台（AIAUTH 平台申请 AppKey/SecretKey）----
MT_APP_KEY=
MT_SECRET_KEY=
MT_ASR_URL=https://speech.meituan.com/asr/v1/long_stream_recognize
# 鉴权方式：ba（默认，HMAC 签名）/ token（OAuth 换 Token）；BA 被拒时代码会自动降级 token
MT_AUTH_MODE=ba
MT_TOKEN_URL=https://auth-ai.vip.sankuai.com/oauth/v2/token

# ---- 保底链路翻译（OpenAI 兼容接口，可指内部 LLM 网关）----
MT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MT_API_KEY=
MT_MODEL=

# 中继服务器自身
PORT=8080
# 小程序 ?token= 与之匹配，留空则不校验（仅调试用）
AUTH_TOKEN=
