.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* ============ 深色主题 ============ */
.theme-dark { background: #101318; color: #eceff4; }
.theme-dark .navbar { color: #eceff4; border-bottom-color: rgba(255,255,255,.08); }
.theme-dark .live-dot { background: #fb8072; }
.theme-dark .zh { color: #eceff4; }
.theme-dark .en { color: #93a7c4; }
.theme-dark .en.pending { color: #5a6373; }
.theme-dark .interim .zh { color: #9aa3b2; }
.theme-dark .footer { background: #0b0d11; }
.theme-dark .status { color: #7a8494; }
.theme-dark .divider { background: rgba(255,255,255,.06); }
.theme-dark .empty { color: #5a6373; }
.theme-dark .theme-toggle { color: #9aa3b2; }

/* ============ 浅色主题 ============ */
.theme-light { background: #f5f3ec; color: #20242c; }
.theme-light .navbar { color: #20242c; border-bottom-color: rgba(0,0,0,.08); }
.theme-light .live-dot { background: #e0534a; }
.theme-light .zh { color: #20242c; }
.theme-light .en { color: #5d6f8c; }
.theme-light .en.pending { color: #a8aeba; }
.theme-light .interim .zh { color: #6b7280; }
.theme-light .footer { background: #edeae0; }
.theme-light .status { color: #8a8f9a; }
.theme-light .divider { background: rgba(0,0,0,.07); }
.theme-light .empty { color: #a8aeba; }
.theme-light .theme-toggle { color: #6b7280; }

/* ============ 顶栏 ============ */
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid transparent;
}

.booth {
  font-size: 22rpx;
  letter-spacing: 6rpx;
}

.live {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.live.on .live-dot { animation: pulse 1.6s ease-in-out infinite; }
.live.off { opacity: .35; }

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: .35; transform: scale(.8); }
}

.theme-toggle {
  font-size: 30rpx;
  padding: 8rpx;
}

/* ============ 字幕区 ============ */
.transcript {
  flex: 1;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
}

.utterance { margin-bottom: 40rpx; }

.chip {
  display: inline-block;
  font-size: 20rpx;
  line-height: 1;
  color: #22242a;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

/* R ColorBrewer Set3，12 色循环 */
.c0 { background: #8DD3C7; }
.c1 { background: #FFFFB3; }
.c2 { background: #BEBADA; }
.c3 { background: #FB8072; }
.c4 { background: #80B1D3; }
.c5 { background: #FDB462; }
.c6 { background: #B3DE69; }
.c7 { background: #FCCDE5; }
.c8 { background: #D9D9D9; }
.c9 { background: #BC80BD; }
.c10 { background: #CCEBC5; }
.c11 { background: #FFED6F; }

.zh {
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 32rpx;
  line-height: 1.6;
  font-weight: 500;
}

.en {
  font-size: 26rpx;
  margin-top: 10rpx;
  line-height: 1.5;
  font-style: italic;
}

.en.pending { font-style: normal; }

.interim .zh { font-weight: 400; }

.divider { height: 1rpx; margin: 8rpx 0 32rpx; }

.empty {
  text-align: center;
  margin-top: 36vh;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.tail { height: 1px; }

/* ============ 底部：仅一个按钮 ============ */
.footer {
  padding: 20rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  margin-bottom: 18rpx;
}

.btn {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.btn::after { border: none; }

.btn-idle { background: #eceff4; }
.btn-idle .icon-start {
  width: 0; height: 0;
  border-left: 36rpx solid #101318;
  border-top: 22rpx solid transparent;
  border-bottom: 22rpx solid transparent;
  margin-left: 8rpx;
}

.btn-rec { background: #fb8072; }
.btn-rec .icon-pause {
  width: 32rpx; height: 40rpx;
  border-left: 10rpx solid #101318;
  border-right: 10rpx solid #101318;
}

.btn-paused { background: #fdb462; }
.btn-paused .icon-start {
  width: 0; height: 0;
  border-left: 36rpx solid #101318;
  border-top: 22rpx solid transparent;
  border-bottom: 22rpx solid transparent;
  margin-left: 8rpx;
}
