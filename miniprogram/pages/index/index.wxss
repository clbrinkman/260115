.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* ============ 深色主题 ============ */
.theme-dark { background: #101318; color: #eceff4; }
.theme-dark .navbar { color: #eceff4; border-bottom-color: rgba(255,255,255,.08); }
.theme-dark .live-dot { background: #fb8072; }
.theme-dark .zh { color: #eceff4; }
.theme-dark .en { color: #93a7c4; }
.theme-dark .en.pending { color: #5a6373; }
.theme-dark .interim .zh { color: #9aa3b2; }
.theme-dark .footer { background: linear-gradient(180deg, rgba(16,19,24,0), #101318 42%); }
.theme-dark .status { color: #7a8494; }
.theme-dark .glass-control {
  background: rgba(31, 35, 43, .62);
  border-color: rgba(255,255,255,.11);
  box-shadow: 0 24rpx 70rpx rgba(0,0,0,.38), inset 0 1rpx 0 rgba(255,255,255,.08);
}
.theme-dark .control-kicker { color: #8993a3; }
.theme-dark .divider { background: rgba(255,255,255,.06); }
.theme-dark .empty { color: #5a6373; }
.theme-dark .theme-toggle { color: #9aa3b2; }

/* ============ 浅色主题 ============ */
.theme-light { background: #f5f3ec; color: #20242c; }
.theme-light .navbar { color: #20242c; border-bottom-color: rgba(0,0,0,.08); }
.theme-light .live-dot { background: #e0534a; }
.theme-light .zh { color: #20242c; }
.theme-light .en { color: #5d6f8c; }
.theme-light .en.pending { color: #a8aeba; }
.theme-light .interim .zh { color: #6b7280; }
.theme-light .footer { background: linear-gradient(180deg, rgba(245,243,236,0), #f5f3ec 42%); }
.theme-light .status { color: #8a8f9a; }
.theme-light .glass-control {
  background: rgba(255,255,255,.58);
  border-color: rgba(255,255,255,.8);
  box-shadow: 0 24rpx 64rpx rgba(80,72,54,.14), inset 0 1rpx 0 rgba(255,255,255,.9);
}
.theme-light .control-kicker { color: #858b96; }
.theme-light .divider { background: rgba(0,0,0,.07); }
.theme-light .empty { color: #a8aeba; }
.theme-light .theme-toggle { color: #6b7280; }

/* ============ 顶栏 ============ */
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid transparent;
}

.booth {
  font-size: 22rpx;
  letter-spacing: 6rpx;
}

.live {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.live.on .live-dot { animation: pulse 1.6s ease-in-out infinite; }
.live.off { opacity: .35; }

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: .35; transform: scale(.8); }
}

.theme-toggle {
  font-size: 30rpx;
  padding: 8rpx;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.summary-entry {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  padding: 6rpx 4rpx;
}
.audio-mode {
  font-size: 20rpx;
  white-space: nowrap;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid currentColor;
  opacity: .72;
}
.theme-dark .audio-mode { color: #8dd3c7; }
.theme-light .audio-mode { color: #397c74; }
.theme-dark .summary-entry { color: #9aa3b2; }
.theme-light .summary-entry { color: #6b7280; }

/* ============ 纪要面板 ============ */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, .5);
  z-index: 99;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 72vh;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}
.theme-dark .sheet { background: #161920; }
.theme-light .sheet { background: #fbf9f4; }

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.sheet-title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  letter-spacing: 6rpx;
}

.sheet-close {
  font-size: 30rpx;
  opacity: .5;
  padding: 8rpx;
}

.sheet-body {
  flex: 1;
  min-height: 30vh;
  max-height: 56vh;
}

.sheet-loading {
  text-align: center;
  margin-top: 12vh;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  opacity: .5;
}

.sheet-text {
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 27rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}
.theme-dark .sheet-text { color: #d7dce4; }
.theme-light .sheet-text { color: #33383f; }

/* ============ 字幕区 ============ */
.transcript {
  flex: 1;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
}

.utterance { margin-bottom: 40rpx; }

.chip {
  display: inline-block;
  font-size: 20rpx;
  line-height: 1;
  color: #22242a;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

/* R ColorBrewer Set3，12 色循环 */
.c0 { background: #8DD3C7; }
.c1 { background: #FFFFB3; }
.c2 { background: #BEBADA; }
.c3 { background: #FB8072; }
.c4 { background: #80B1D3; }
.c5 { background: #FDB462; }
.c6 { background: #B3DE69; }
.c7 { background: #FCCDE5; }
.c8 { background: #D9D9D9; }
.c9 { background: #BC80BD; }
.c10 { background: #CCEBC5; }
.c11 { background: #FFED6F; }

.zh {
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 32rpx;
  line-height: 1.6;
  font-weight: 500;
}

.en {
  font-size: 26rpx;
  margin-top: 10rpx;
  line-height: 1.5;
  font-style: italic;
}

.en.pending { font-style: normal; }

.interim .zh { font-weight: 400; }

.divider { height: 1rpx; margin: 8rpx 0 32rpx; }

.empty {
  text-align: center;
  margin-top: 36vh;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.tail { height: 1px; }

/* ============ 底部毛玻璃控制舱 ============ */
.footer {
  padding: 42rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  margin-top: -30rpx;
  position: relative;
  z-index: 10;
}

.glass-control {
  min-height: 112rpx;
  border: 1rpx solid transparent;
  border-radius: 34rpx;
  padding: 16rpx 16rpx 16rpx 28rpx;
  display: flex;
  align-items: center;
  backdrop-filter: blur(34rpx) saturate(155%);
  -webkit-backdrop-filter: blur(34rpx) saturate(155%);
}

.control-copy {
  min-width: 0;
  flex: 1;
}

.control-kicker {
  display: flex;
  align-items: center;
  font-size: 17rpx;
  line-height: 1;
  letter-spacing: 4rpx;
  margin-bottom: 11rpx;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #87909e;
  margin-right: 12rpx;
  box-shadow: 0 0 0 7rpx rgba(135,144,158,.1);
}

.is-recording .status-dot {
  background: #fb8072;
  box-shadow: 0 0 0 7rpx rgba(251,128,114,.13), 0 0 22rpx rgba(251,128,114,.65);
  animation: glassPulse 1.8s ease-in-out infinite;
}

.status {
  font-size: 25rpx;
  line-height: 1.2;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wave {
  height: 42rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin: 0 24rpx 0 16rpx;
}

.wave-bar {
  width: 5rpx;
  height: 14rpx;
  border-radius: 99rpx;
  background: #fb8072;
  animation: wave 1s ease-in-out infinite;
}
.wave .b2 { animation-delay: -.22s; }
.wave .b3 { animation-delay: -.44s; }
.wave .b4 { animation-delay: -.66s; }

@keyframes wave {
  0%, 100% { height: 12rpx; opacity: .45; }
  50% { height: 38rpx; opacity: 1; }
}

@keyframes glassPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(.82); opacity: .65; }
}

.btn {
  width: 84rpx;
  height: 84rpx;
  min-width: 84rpx;
  max-width: 84rpx;
  min-height: 84rpx;
  max-height: 84rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 84rpx;
  flex: none;
  overflow: hidden;
  transition: transform .16s ease, opacity .16s ease;
}

.btn::after { border: none; }
.btn-hover { transform: scale(.93); opacity: .86; }
.btn[disabled] { opacity: .45; }

.btn-idle {
  background: #eceff4;
  box-shadow: 0 10rpx 28rpx rgba(0,0,0,.2);
}
.btn-idle .icon-start {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #fb8072;
  box-shadow: 0 0 0 8rpx rgba(251,128,114,.14);
}

.btn-rec {
  background: #fb8072;
  box-shadow: 0 12rpx 30rpx rgba(251,128,114,.28);
}
.btn-rec .icon-pause {
  height: 30rpx;
  display: flex;
  align-items: stretch;
  gap: 9rpx;
}
.btn-rec .icon-pause view {
  width: 8rpx;
  border-radius: 4rpx;
  background: #181b20;
}

.btn-paused {
  background: #fdb462;
  box-shadow: 0 12rpx 30rpx rgba(253,180,98,.25);
}
.btn-paused .icon-start {
  width: 0; height: 0;
  border-left: 22rpx solid #181b20;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  margin-left: 5rpx;
}
